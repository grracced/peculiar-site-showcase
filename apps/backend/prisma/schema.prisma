// This is your Prisma schema file.
// Source of Truth: VerifAI_Database_Design.md
// Learn more about Prisma schemas: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMERATIONS
// Mirror the approved domain enumerations in user.enums.ts
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

// ---------------------------------------------------------------------------
// MODELS
// ---------------------------------------------------------------------------

/// Core identity table. Authentication (password) is managed by Supabase Auth.
/// Application-specific data lives in UserProfile (1:1 relationship).
model User {
  // Primary key: UUID generated by the database for shard-safety.
  id String @id @default(uuid()) @db.Uuid

  // Unique, normalized (lowercase) email used as the login identifier.
  email String @unique @db.VarChar(255)

  // The user's assigned privilege level. Defaults to standard USER.
  role UserRole @default(USER)

  // Operational account state. New accounts start as PENDING_VERIFICATION.
  status AccountStatus @default(PENDING_VERIFICATION)

  // Set to true after the user clicks the confirmation link in their welcome email.
  emailVerified Boolean @default(false) @map("email_verified")

  // Verification token hash stored securely (SHA-256)
  verificationTokenHash String? @map("verification_token_hash") @db.VarChar(64)

  // Expiration timestamp for the verification link
  verificationTokenExpiresAt DateTime? @map("verification_token_expires_at")

  // Audit timestamp for when verification succeeded
  emailVerifiedAt DateTime? @map("email_verified_at")

  // Password reset fields securely hashed
  passwordResetTokenHash String? @map("password_reset_token_hash") @db.VarChar(64)
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  passwordChangedAt DateTime? @map("password_changed_at")

  // Lockout tracking fields
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockoutUntil DateTime? @map("lockout_until")

  // Audit timestamps — automatically managed.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Soft-delete field. When set, the account is considered deleted.
  // CRITICAL: This row is NEVER physically removed; doing so would break
  // referential integrity with immutable verification records on Hedera.
  deletedAt DateTime? @map("deleted_at")

  // Relationships
  profile UserProfile?
  sessions UserSession[]
  passwordHistories PasswordHistory[]

  // Table name in snake_case per PostgreSQL convention.
  @@map("users")

  // Index on deletedAt to allow efficient filtering of soft-deleted users.
  @@index([deletedAt], name: "idx_users_deleted_at")
}

/// Application-specific user data, decoupled from the auth record.
/// Always created immediately after a User row is inserted (1:1 relationship).
model UserProfile {
  // Primary key: UUID generated by the database.
  id String @id @default(uuid()) @db.Uuid

  // Foreign key: points to the parent User. The @unique constraint enforces 1:1.
  userId String @unique @db.Uuid @map("user_id")

  // Display name. Nullable until the user fills in their profile.
  fullName String? @map("full_name") @db.VarChar(100)

  // URL to the user's avatar stored in Supabase Storage. Nullable.
  avatarUrl String? @map("avatar_url") @db.VarChar(2048)

  // Billing tier. Defaults to FREE for all new accounts.
  subscriptionTier SubscriptionTier @default(FREE) @map("subscription_tier")

  // Audit timestamps.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relation back to the parent User.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")

  // Index recommended by Database Design for efficient dashboard joins.
  @@index([userId], name: "idx_user_profiles_user_id")
}

model UserSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  issuedAt DateTime @default(now()) @map("issued_at")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  deviceName String? @map("device_name") @db.VarChar(255)
  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(512)

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model PasswordHistory {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  passwordHash String @map("password_hash") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_histories")
}
